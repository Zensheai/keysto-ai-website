# MailerLite email signup — set these as SERVER-SIDE env vars in Vercel
# (Project → Settings → Environment Variables). Do NOT use a VITE_ prefix:
# these must stay on the server so the API key is never shipped to the browser.
# The serverless function at /api/subscribe reads them.
MAILERLITE_TOKEN=
# Optional — a MailerLite group/list id to add subscribers to. Leave blank to
# just add them to the account.
MAILERLITE_GROUP_ID=
